#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && pwd -P)

strict_portfolio_git() {
    /usr/bin/env -i \
        HOME=/nonexistent-corelm-portfolio-bootstrap \
        PATH=/usr/bin:/bin:/usr/sbin:/sbin \
        LANG=C \
        LC_ALL=C \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_NO_REPLACE_OBJECTS=1 \
        GIT_OPTIONAL_LOCKS=0 \
        GIT_TERMINAL_PROMPT=0 \
        /usr/bin/git \
            -c core.fsmonitor=false \
            -c core.untrackedCache=false \
            -c core.trustctime=true \
            -c core.checkStat=default \
            -c core.hooksPath=/dev/null \
            -C "$PROJECT_DIR" "$@"
}

strict_portfolio_python_bootstrap() {
    [ -x /usr/bin/git ] || {
        printf '%s\n' 'portfolio demo requires /usr/bin/git' >&2
        return 1
    }
    [ -z "$(strict_portfolio_git for-each-ref --format='%(refname)' refs/replace)" ] || {
        printf '%s\n' 'portfolio demo forbids Git replacement refs' >&2
        return 1
    }
    graft_path=$(strict_portfolio_git rev-parse --git-path info/grafts)
    case "$graft_path" in
        /*) ;;
        *) graft_path="$PROJECT_DIR/$graft_path" ;;
    esac
    [ ! -e "$graft_path" ] || {
        printf '%s\n' 'portfolio demo forbids legacy Git grafts' >&2
        return 1
    }
    for sparse_key in core.sparseCheckout core.sparseCheckoutCone index.sparse; do
        sparse_value=$(strict_portfolio_git config --bool "$sparse_key" 2>/dev/null || :)
        [ -z "$sparse_value" ] || [ "$sparse_value" = false ] || {
            printf '%s\n' 'portfolio demo forbids sparse checkout and sparse index' >&2
            return 1
        }
    done
    for flag_view in -t -v -f; do
        flag_rows=$(strict_portfolio_git ls-files "$flag_view") || return 1
        if [ -n "$flag_rows" ] && printf '%s\n' "$flag_rows" | /usr/bin/grep -qv '^H '; then
            printf '%s\n' 'portfolio demo forbids hidden Git index flags' >&2
            return 1
        fi
    done
    strict_portfolio_git diff-index --cached --quiet HEAD -- || {
        printf '%s\n' 'portfolio demo index differs from signed HEAD' >&2
        return 1
    }
    strict_portfolio_git diff-files --quiet --ignore-submodules=none -- || {
        printf '%s\n' 'portfolio demo tracked bytes differ from signed HEAD' >&2
        return 1
    }
    bootstrap_status=$(strict_portfolio_git status \
        --porcelain=v1 \
        --untracked-files=all \
        --ignored=no \
        --ignore-submodules=none) || return 1
    [ -z "$bootstrap_status" ] || {
        printf '%s\n' \
            'portfolio demo forbids untracked source files' >&2
        return 1
    }
    ignored_source=$(strict_portfolio_git ls-files \
        --others --ignored --exclude-standard -- \
        . ':(exclude)dist/CoreLMBenchmark.app/**') || return 1
    [ -z "$ignored_source" ] || {
        printf '%s\n' \
            'portfolio demo forbids ignored paths outside the verified app bundle' >&2
        return 1
    }
}

usage() {
    cat <<'EOF'
Usage:
  ./corelm macos doctor [options]
  ./corelm macos bootstrap [options]
  ./corelm macos build [options]
  ./corelm macos package [options]
  ./corelm macos prepare-offline [options]
  ./corelm macos proof [options]
  ./corelm macos portfolio-demo [options]
  ./corelm linux doctor [options]
  ./corelm linux bootstrap [options]
  ./corelm linux build [options]
  ./corelm linux run [options]
  ./corelm beacon verify-tag
  ./corelm verify

macOS builds the native SwiftUI application and runs the real Qwen proof on
Apple MPS. Linux builds an isolated CPU runtime and runs the same registered
public-validation regression without claiming a new blind result. Beacon is a
read-only compatibility contour; it cannot launch the one-shot experiment.
EOF
}

case "${1:-}" in
    -h|--help|'')
        usage
        exit 0
        ;;
    verify)
        shift
        [ "$#" -eq 0 ] || {
            printf '%s\n' './corelm verify accepts no arguments' >&2
            exit 2
        }
        "$PROJECT_DIR/scripts/verify-python.sh"
        exec "$PROJECT_DIR/scripts/verify-python.sh" \
            Tests.test_publication_archives
        ;;
    macos|linux|beacon)
        platform=$1
        shift
        ;;
    *)
        printf 'Unknown platform or command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

command=${1:-}
[ -n "$command" ] || {
    usage >&2
    exit 2
}
shift

case "$platform:$command" in
    macos:doctor) script=platforms/macos/scripts/doctor.sh ;;
    macos:bootstrap) script=platforms/macos/scripts/bootstrap-python.sh ;;
    macos:build) script=platforms/macos/scripts/build-app.sh ;;
    macos:package) script=platforms/macos/scripts/package-app.sh ;;
    macos:prepare-offline) script=platforms/macos/scripts/prepare-offline.sh ;;
    macos:proof) script=platforms/macos/scripts/run-proof.sh ;;
    macos:portfolio-demo)
        case "${1:-}" in
            -h|--help)
                printf '%s\n' \
                    'usage: ./corelm macos portfolio-demo --tag corelm-portfolio-v8 --output DIRECTORY --ffmpeg ABSOLUTE_PATH --ffprobe ABSOLUTE_PATH'
                exit 0
                ;;
            *) strict_portfolio_python_bootstrap ;;
        esac
        automated_python="$HOME/.cache/corelm/macos/runtime/bin/python"
        [ -x "$automated_python" ] || {
            printf '%s\n' \
                'macOS runtime is missing; run ./corelm macos prepare-offline first' >&2
            exit 1
        }
        portfolio_tmp_root=${TMPDIR:-/tmp}
        case "$portfolio_tmp_root" in
            /*) ;;
            *)
                printf '%s\n' 'portfolio TMPDIR must be absolute' >&2
                exit 2
                ;;
        esac
        portfolio_tmp_root=$(CDPATH= cd -- "$portfolio_tmp_root" && pwd -P) || {
            printf '%s\n' 'portfolio TMPDIR is unavailable' >&2
            exit 2
        }
        case "$portfolio_tmp_root/" in
            "$PROJECT_DIR/"|"$PROJECT_DIR/"*)
                printf '%s\n' \
                    'portfolio Python cache must be outside the source checkout' >&2
                exit 2
                ;;
        esac
        portfolio_pycache=$(/usr/bin/mktemp -d \
            "$portfolio_tmp_root/corelm-portfolio-pycache.XXXXXX")
        portfolio_pycache=$(CDPATH= cd -- "$portfolio_pycache" && pwd -P)
        /bin/chmod 700 "$portfolio_pycache"
        portfolio_status=0
        /usr/bin/env -i \
            HOME="$HOME" \
            TMPDIR="$portfolio_tmp_root" \
            PATH=/usr/bin:/bin:/usr/sbin:/sbin \
            LANG=C \
            LC_ALL=C \
            CORELM_OFFLINE="${CORELM_OFFLINE:-}" \
            CORELM_WHEELHOUSE="${CORELM_WHEELHOUSE:-}" \
            "$automated_python" -I -B -X "pycache_prefix=$portfolio_pycache" \
            "$PROJECT_DIR/platforms/macos/scripts/run-automated-portfolio-demo.py" \
            "$@" || portfolio_status=$?
        if ! /bin/rmdir "$portfolio_pycache"; then
            printf '%s\n' \
                'portfolio Python cache boundary was not empty after execution' >&2
            exit 1
        fi
        exit "$portfolio_status"
        ;;
    linux:doctor) script=platforms/linux/scripts/doctor.sh ;;
    linux:bootstrap) script=platforms/linux/scripts/bootstrap-python.sh ;;
    linux:build) script=platforms/linux/scripts/build-runtime.sh ;;
    linux:run) script=platforms/linux/scripts/run-regression.sh ;;
    beacon:verify-tag) script=platforms/beacon/scripts/verify-frozen-tag.py ;;
    *)
        printf 'Unknown command: %s %s\n\n' "$platform" "$command" >&2
        usage >&2
        exit 2
        ;;
esac

[ "$platform" != beacon ] || [ "$#" -eq 0 ] || {
    printf '%s\n' './corelm beacon verify-tag accepts no arguments' >&2
    exit 2
}

exec "$PROJECT_DIR/$script" "$@"
