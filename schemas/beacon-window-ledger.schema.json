            "split": "validation",
            "startBlock": 0,
            "status": "evaluated"
          }
        },
        {
          "const": {
            "endBlockExclusive": null,
            "reason": "the public application permits user-selected validation ranges, so no remaining validation window is represented as procedurally blind",
            "split": "validation",
            "startBlock": 72,
            "status": "excluded-entire-remainder"
          }
        },
        {
          "const": {
            "endBlockExclusive": 8,
            "reason": "conservative buffer before the historical exploratory pilot",
            "split": "test",
            "startBlock": 0,
            "status": "excluded-buffer"
