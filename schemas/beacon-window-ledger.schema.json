  "$id": "https://github.com/ALLPROTO/core-lm-benchmark/schemas/beacon-window-ledger.schema.json",
  "title": "Core LM beacon held-out window ledger",
  "description": "Fail-closed inventory of eligible and excluded WikiText-2 windows for the beacon-held-out v1 suite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit",
    "corpus",
    "eligibleWindows",
    "excludedRanges",
    "schemaVersion",
    "suiteId"
