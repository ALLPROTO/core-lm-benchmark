        "auditCommit": {"$ref": "#/$defs/gitCommit"},
        "auditDate": {"const": "2026-08-01"},
        "scope": {
          "const": "Published repository artifacts and source-range declarations"
        },
        "statement": {
          "const": "Eligible means no metric result for the window was found in the audited public repository. It does not prove that a public corpus window was never viewed or privately evaluated."
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allTokenIdsSHA256",
        "blockTokens",
        "configuration",
        "fileBytes",
        "fileSHA256",
        "filename",
        "fullBlocks",
        "inventoryMethod",
        "remainderTokens",
        "repository",
        "revision",
        "split",
        "tokenCount",
        "tokenizerRepository",
        "tokenizerRevision"
