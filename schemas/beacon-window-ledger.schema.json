      "properties": {
        "allTokenIdsSHA256": {
          "const": "b44603066a92719a20e2dc18d6c5f7f5342b1877c20c1e2bdd92deca662d3d56"
        },
        "blockTokens": {"const": 512},
        "configuration": {"const": "wikitext-2-raw-v1"},
