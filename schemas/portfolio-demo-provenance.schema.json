{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-benchmark/schemas/portfolio-demo-provenance.schema.json",
  "title": "Core LM automated portfolio demo provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tag",
    "source",
    "video",
    "poster",
    "capture",
    "application_executable_sha256",
    "result_sha256",
    "receipt_sha256",
    "evidence_sha256",
    "workload_classification",
    "synthetic_data"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "tag": {"$ref": "#/$defs/tag"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "duration_seconds",
        "width",
        "height",
        "codec",
        "audio_codec",
        "evidence_role"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "width": {"$ref": "#/$defs/positiveInteger"},
        "height": {"$ref": "#/$defs/positiveInteger"},
        "codec": {"const": "h264"},
        "audio_codec": {"const": "silent"},
        "evidence_role": {"$ref": "#/$defs/mediaClassification"}
      }
    },
    "poster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "width",
        "height",
        "frame_timestamp_seconds",
        "evidence_role"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"$ref": "#/$defs/positiveInteger"},
        "height": {"$ref": "#/$defs/positiveInteger"},
        "frame_timestamp_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "evidence_role": {"$ref": "#/$defs/mediaClassification"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "automation_contract",
        "mode",
        "automation_only",
        "human_reviewed",
        "manual_edits",
        "machine_evidence",
        "pixel_semantics_verified",
        "automation_receipt_sha256",
        "result_readiness_sha256"
      ],
      "properties": {
        "platform": {"const": "macOS"},
        "architecture": {"const": "arm64"},
        "automation_contract": {"const": "corelm-automated-presentation-v2"},
        "mode": {"const": "MACOS_SINGLE_WINDOW_ID_V1"},
        "automation_only": {"const": true},
        "human_reviewed": {"const": false},
        "manual_edits": {"const": false},
        "machine_evidence": {"const": false},
        "pixel_semantics_verified": {"const": false},
        "automation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "result_readiness_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "application_executable_sha256": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "workload_classification": {
      "const": "AUTHOR_SELECTED_PUBLIC_VALIDATION_REGRESSION"
    },
    "synthetic_data": {"const": false}
  },
  "$defs": {
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tag": {
      "type": "string",
      "pattern": "^corelm-portfolio-v[1-9][0-9]*$"
    },
    "positiveInteger": {"type": "integer", "minimum": 1},
    "mediaClassification": {
      "const": "AUTOMATED_PRESENTATION_NOT_MACHINE_EVIDENCE"
    }
  }
}
