{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ALLPROTO/core-lm-benchmark/schemas/beacon-registration.schema.json",
  "title": "Core LM future-beacon held-out preregistration",
  "description": "Fail-closed schema for the frozen Core LM beacon-held-out v1 registration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attemptPolicy",
    "author",
    "beacon",
    "claimBoundary",
    "configuration",
    "configurationSHA256",
    "corpus",
    "evaluation",
    "execution",
    "gates",
    "model",
    "outcomePolicy",
    "protocolSourceFiles",
    "publicFreeze",
    "regressionPolicy",
    "runtime",
    "schemaVersion",
    "selection",
    "status",
    "suiteId"
  ],
  "properties": {
    "attemptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptPath",
        "beaconFetchedAfterMarker",
        "crashConsumesSuite",
        "createdBeforeBeaconAndDataResolution",
        "exclusiveDurableCreation",
        "firstPublicAttemptIsNormative",
        "rerunAfterMarker"
      ],
      "properties": {
        "attemptPath": {"const": "real-llm-beacon-results/attempt.json"},
        "beaconFetchedAfterMarker": {"const": true},
        "crashConsumesSuite": {"const": true},
        "createdBeforeBeaconAndDataResolution": {"const": true},
        "exclusiveDurableCreation": {"const": true},
        "firstPublicAttemptIsNormative": {"const": true},
        "rerunAfterMarker": {"const": false}
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "name", "orcid"],
      "properties": {
        "github": {"const": "https://github.com/ALLPROTO"},
        "name": {"const": "Ivan Tyshchenko"},
        "orcid": {"const": "https://orcid.org/0009-0000-7935-6090"}
      }
    },
    "beacon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificateEndpointPrefix",
        "exactPulseRequired",
        "expectedCertificateId",
        "fallback",
        "periodMilliseconds",
        "pulseEndpoint",
        "service",
        "targetTimestamp",
        "targetUnixMilliseconds",
        "verification",
        "version"
      ],
      "properties": {
        "certificateEndpointPrefix": {
          "const": "https://beacon.nist.gov/beacon/2.0/certificate/"
        },
        "exactPulseRequired": {"const": true},
        "expectedCertificateId": {
          "const": "528943a555f5f8ca54423be6dfb95925a35c7b552046420e7d7cd072058a14d6536ad3a8e9754b6582f164a90b0cd86a65d659f5426a2659a947595d1c816c8c"
        },
        "fallback": {"const": "forbidden"},
        "periodMilliseconds": {"const": 60000},
        "pulseEndpoint": {
          "const": "https://beacon.nist.gov/beacon/2.0/pulse/time/1785693600000"
        },
        "service": {"const": "NIST Randomness Beacon"},
        "targetTimestamp": {"const": "2026-08-02T18:00:00.000Z"},
        "targetUnixMilliseconds": {"const": 1785693600000},
        "verification": {
          "const": [
            "HTTPS retrieval from the frozen endpoint",
            "exact timestamp, version, period, status, chain and URI structure",
            "certificateId equals SHA-512 of the returned DER certificate",
            "RSA PKCS#1 v1.5 SHA-512 signature over the NIST IR 8213 pulse serialization",
            "outputValue equals SHA-512 of the serialized signed fields plus signature"
          ]
        },
        "version": {"const": "2.0"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceClass", "excludes", "statement"],
      "properties": {
        "evidenceClass": {
          "const": "post-freeze-beacon-selected-heldout-window"
        },
        "excludes": {
          "const": [
            "proof that no person privately evaluated any public WikiText-2 window",
            "models or revisions other than the pinned Qwen target",
            "datasets, tokenizers, or windows outside this registration",
            "free-running or sampled generation",
            "latency, energy, and production-serving claims",
            "cross-device exact-logit reproducibility",
            "generalization to LLMs or corpora in general"
          ]
        },
        "statement": {
          "const": "A one-shot, future-beacon-selected, previously unreported 32-block WikiText-2 test window evaluates the already frozen VoidToken v5 configuration. A completed result establishes only whether the frozen gates pass on that selected window and is limited evidence of transfer within the registered eligible-window pool, not corpus-wide generalization."
        }
      }
    },
    "configuration": {"$ref": "#/$defs/configuration"},
    "configurationSHA256": {
      "const": "4c7be8c836aa725722b51f66dce78af7a5094e887432e622b5322f7ca2cf0af8"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockTokens",
        "configuration",
        "file",
        "fileBytes",
        "fileSHA256",
        "joinSeparator",
        "normalization",
        "repository",
        "revision",
        "rowOrder",
        "split",
        "tokenization"
      ],
      "properties": {
        "blockTokens": {"const": 512},
        "configuration": {"const": "wikitext-2-raw-v1"},
        "file": {"const": "wikitext-2-raw-v1/test-00000-of-00001.parquet"},
        "fileBytes": {"const": 732610},
        "fileSHA256": {
          "const": "5f1bea067869d04849c0f975a2b29c4ff47d867f484f5010ea5e861eab246d91"
        },
        "joinSeparator": {"const": "\n\n"},
        "normalization": {"const": "none"},
        "repository": {"const": "Salesforce/wikitext"},
        "revision": {"const": "b08601e04326c79dfdd32d625aee71d232d685c3"},
        "rowOrder": {"const": "stored-order"},
        "split": {"const": "test"},
        "tokenization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "addSpecialTokens",
            "allTokenIdsSHA256",
            "fullBlocks",
            "remainderTokens",
            "tokenCount",
            "tokenizerRevision"
          ],
          "properties": {
            "addSpecialTokens": {"const": false},
            "allTokenIdsSHA256": {
              "const": "b44603066a92719a20e2dc18d6c5f7f5342b1877c20c1e2bdd92deca662d3d56"
            },
            "fullBlocks": {"const": 584},
            "remainderTokens": {"const": 70},
            "tokenCount": {"const": 299078},
            "tokenizerRevision": {
              "const": "060db6499f32faf8b98477b0a26969ef7d8b9987"
            }
          }
        }
      }
    },
    "evaluation": {
      "const": {
        "attentionImplementation": "eager",
        "blockTokens": 512,
        "cacheCanonicalization": "FP32-to-BF16-to-FP32",
        "candidateConfigurationId": "4c7be8c836aa7257",
        "candidateConfigurationSHA256": "4c7be8c836aa725722b51f66dce78af7a5094e887432e622b5322f7ca2cf0af8",
        "candidateDevelopmentGridIndex": 32,
        "compressionByteAccounting": "complete-container-bytes",
        "layers": 24,
        "predictionMode": "teacher-forced",
        "predictionsPerBlock": 128,
        "prefillTokens": 383,
        "trajectoryShapePerLayer": [383, 256],
        "windowBlocks": 32
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline",
        "device",
        "localPythonBytecode",
        "modelDtype",
        "outcomePath",
        "primaryEvidenceDirectory",
        "pythonBytecodeWrites",
        "pythonIsolatedMode",
        "resolutionPath",
        "seed",
        "torchDeterministicAlgorithms"
      ],
      "properties": {
        "deadline": {"const": "2026-08-04T18:00:00.000Z"},
        "device": {"const": "mps"},
        "localPythonBytecode": {"const": "forbidden"},
        "modelDtype": {"const": "float32"},
        "outcomePath": {"const": "real-llm-beacon-results/outcome.json"},
        "primaryEvidenceDirectory": {
          "const": "real-llm-beacon-results/primary-evidence"
        },
        "pythonBytecodeWrites": {"const": false},
        "pythonIsolatedMode": {"const": true},
        "resolutionPath": {
          "const": "real-llm-beacon-results/resolution.json"
        },
        "seed": {"const": 20260729},
        "torchDeterministicAlgorithms": {"const": "warn-only"}
      }
    },
    "gates": {"$ref": "#/$defs/gatesDefinition"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "repository",
        "revision",
        "trustRemoteCode",
        "weightsBytes",
        "weightsSHA256"
      ],
      "properties": {
        "architecture": {"const": "Qwen2ForCausalLM"},
        "repository": {"const": "Qwen/Qwen2.5-0.5B"},
        "revision": {"const": "060db6499f32faf8b98477b0a26969ef7d8b9987"},
        "trustRemoteCode": {"const": false},
        "weightsBytes": {"const": 988097824},
        "weightsSHA256": {
          "const": "88c142557820ccad55bb59756bfcfcf891de9cc6202816bd346445188a0ed342"
        }
      }
    },
    "outcomePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionDeadlineMiss",
        "missingOutcomeAfterAttempt",
        "scientificFailExitCode",
        "terminalVerdicts",
        "unexpectedErrorExitCode"
      ],
      "properties": {
        "executionDeadlineMiss": {"const": "PROTOCOL_FAILURE"},
        "missingOutcomeAfterAttempt": {"const": "CONSUMED_INCOMPLETE"},
        "scientificFailExitCode": {"const": 2},
        "terminalVerdicts": {
          "const": ["PASS", "FAIL_GATES", "FAIL_EXECUTION"]
        },
        "unexpectedErrorExitCode": {"const": 1}
      }
    },
    "protocolSourceFiles": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
      },
      "allOf": [
        {"contains": {"const": "RealLLM/beacon_registration.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "RealLLM/beacon_window_ledger.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "RealLLM/run_beacon_one_shot.py"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "schemas/beacon-attempt.schema.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "schemas/beacon-outcome.schema.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "schemas/beacon-registration.schema.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "schemas/beacon-resolution.schema.json"}, "minContains": 1, "maxContains": 1},
        {"contains": {"const": "schemas/beacon-window-ledger.schema.json"}, "minContains": 1, "maxContains": 1}
      ]
    },
    "publicFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freezeManifest",
        "immutableReleaseRequired",
        "publicRepository",
        "releaseApi",
        "releasePublishedBeforeBeacon",
        "releaseUrl",
        "requiredTag",
        "tagRefApi"
      ],
      "properties": {
        "freezeManifest": {"const": "RealLLM/beacon_freeze.json"},
        "immutableReleaseRequired": {"const": true},
        "publicRepository": {
          "const": "https://github.com/ALLPROTO/core-lm-benchmark"
        },
        "releaseApi": {
          "const": "https://api.github.com/repos/ALLPROTO/core-lm-benchmark/releases/tags/corelm-beacon-heldout-v1"
        },
        "releasePublishedBeforeBeacon": {"const": true},
        "releaseUrl": {
          "const": "https://github.com/ALLPROTO/core-lm-benchmark/releases/tag/corelm-beacon-heldout-v1"
        },
        "requiredTag": {"const": "corelm-beacon-heldout-v1"},
        "tagRefApi": {
          "const": "https://api.github.com/repos/ALLPROTO/core-lm-benchmark/git/ref/tags/corelm-beacon-heldout-v1"
        }
      }
    },
    "regressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedAfterTerminalScientificOutcome",
        "countsTowardScientificVerdict",
        "evidenceClass",
        "outputDirectory",
        "sameResolvedWindowRequired"
      ],
      "properties": {
        "allowedAfterTerminalScientificOutcome": {"const": true},
        "countsTowardScientificVerdict": {"const": false},
        "evidenceClass": {"const": "regression-only"},
        "outputDirectory": {
          "const": "real-llm-beacon-results/regressions"
        },
        "sameResolvedWindowRequired": {"const": true}
      }
    },
    "runtime": {
      "const": {
        "hfHomePolicy": {
          "absolutePathRequired": true,
          "ownerOnlyRequired": true,
          "pathFrozen": false,
          "privateCacheRequired": true
        },
        "processEnvironment": {
          "HF_HUB_DISABLE_IMPLICIT_TOKEN": "1",
          "HF_HUB_DISABLE_PROGRESS_BARS": "1",
          "HF_HUB_DISABLE_TELEMETRY": "1",
          "HF_HUB_OFFLINE": "1",
          "MKL_NUM_THREADS": "2",
          "NUMEXPR_NUM_THREADS": "2",
          "OMP_NUM_THREADS": "2",
          "OPENBLAS_NUM_THREADS": "2",
          "PYTORCH_ENABLE_MPS_FALLBACK": "0",
          "PYTORCH_MPS_FAST_MATH": "0",
          "PYTORCH_MPS_HIGH_WATERMARK_RATIO": "0.85",
          "PYTORCH_MPS_LOW_WATERMARK_RATIO": "0.75",
          "PYTORCH_MPS_PREFER_METAL": "0",
          "TOKENIZERS_PARALLELISM": "false",
          "TRANSFORMERS_OFFLINE": "1",
          "VECLIB_MAXIMUM_THREADS": "2"
        },
        "resourcePolicy": {
          "concurrentProofRunsForbidden": true,
          "emptyMPSCacheAfterEachBlock": true,
          "evaluateBlocksSequentially": true,
          "minimumFreeMemoryPercent": 15,
          "minimumPhysicalMemoryGiB": 8
        },
        "versions": {
          "huggingfaceHub": "1.25.1",
          "numpy": "2.5.1",
          "pyarrow": "23.0.1",
          "python": "3.12.13",
          "safetensors": "0.8.0",
          "tokenizers": "0.22.2",
          "torch": "2.13.0",
          "transformers": "5.14.1",
          "zlibCompileVersion": "1.2.12",
          "zlibRuntimeVersion": "1.2.12"
        }
      }
    },
    "schemaVersion": {"const": "corelm-beacon-registration-v1"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "domainSeparatorHex",
        "mapping",
        "registrationBytes",
        "windowBlocks",
        "windowLedgerPath",
        "windowLedgerSHA256"
      ],
      "properties": {
        "candidateCount": {"const": 15},
        "domainSeparatorHex": {
          "const": "436f72654c4d2f626561636f6e2d68656c646f75742f763100"
        },
        "mapping": {
          "const": "For counter=0,1,... compute SHA-512(domain || uint64be(len(registrationBytes)) || registrationBytes || outputValueBytes || uint64be(counter)); interpret big-endian; accept when x < 2^512-(2^512 mod N); select candidate x mod N."
        },
        "registrationBytes": {
          "const": "exact committed bytes of RealLLM/beacon_registration.json"
        },
        "windowBlocks": {"const": 32},
        "windowLedgerPath": {"const": "RealLLM/beacon_window_ledger.json"},
        "windowLedgerSHA256": {
          "const": "81e84d09682bb4beab5f42c8bd87179a874b879eaf6e6ca539723e54bbc75a83"
        }
      }
    },
    "status": {
      "const": "preregistered-awaiting-public-freeze-and-future-beacon"
    },
    "suiteId": {
      "const": "qwen2.5-0.5b-kv-voidtoken-v5-beacon-heldout-v1"
    }
  },
  "$defs": {
    "configuration": {
      "const": {
        "backend": "voidtoken-v5",
        "bitsByLayer": [9, 8, 8, 8, 8, 8, 8, 8, 9, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8],
        "codeCompression": "zlib-9",
        "groupSize": 128,
        "scaleCompression": "zlib-9",
        "schedule": "group-kl-top-2-9bit-rest-8bit",
        "signMode": "none",
        "transformBlockSize": 128
      }
    },
    "gatesDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBlockwiseDeltaNLLUpperOneSided95",
        "maximumDeltaNLLNatPerToken",
        "minimumBlockwiseTop1LowerOneSided95",
        "minimumCompressionRatioVsBF16",
        "minimumTop1Agreement",
        "minimumWilsonLowerOneSided95",
        "requireStructuralReplay",
        "studentTCriticalOneSided95Df31",
        "wilsonZOneSided95"
      ],
      "properties": {
        "maximumBlockwiseDeltaNLLUpperOneSided95": {"const": 0.01},
        "maximumDeltaNLLNatPerToken": {"const": 0.01},
        "minimumBlockwiseTop1LowerOneSided95": {"const": 0.99},
        "minimumCompressionRatioVsBF16": {"const": 2.0},
        "minimumTop1Agreement": {"const": 0.99},
        "minimumWilsonLowerOneSided95": {"const": 0.99},
        "requireStructuralReplay": {"const": true},
        "studentTCriticalOneSided95Df31": {"const": 1.6955187825458675},
        "wilsonZOneSided95": {"const": 1.6448536269514715}
      }
    }
  }
}
