{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core LM Benchmark Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "coreArithmeticVersion",
    "configuration",
    "environment",
    "inputDigest",
    "coreStateDigest",
    "voidTokenPayloadDigest",
    "voidTokenContainerDigest",
    "voidTokenReconstructionDigest",
    "methods",
    "timeSeries",
    "invariants",
    "verdict",
    "verdictReasons"
  ],
  "properties": {
    "schemaVersion": {"const": "0.3"},
    "runId": {"type": "string"},
    "createdAt": {"type": "string"},
    "coreArithmeticVersion": {"const": "fixed-order-f64-v1"},
    "configuration": {"type": "object"},
    "environment": {"type": "object"},
    "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coreStateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "voidTokenPayloadDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "voidTokenContainerDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "voidTokenReconstructionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coreRuntimeNanoseconds": {"type": "integer"},
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "payloadBytes", "fileBytes", "compressionRatio", "normalizedRMSE", "cosineSimilarity"]
      }
    },
    "timeSeries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "stateNorm", "energy", "csi", "energyDrift", "pcaRMSE", "voidTokenRMSE"]
      }
    },
    "invariants": {
      "type": "object",
      "required": ["violations", "deterministicReplay", "details"]
    },
    "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "verdictReasons": {"type": "array", "items": {"type": "string"}}
  }
}
